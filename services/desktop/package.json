{
  "name": "@lol/desktop",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "description": "LeagueOfLeagues desktop client (Electron + TypeScript). Autonomous LCU lobby orchestrator + result reporter. Runs natively; built/signed per-OS in CI.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:renderer",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "dist:all": "npm run build && electron-builder --config electron-builder.yml --mac --win --publish never"
  },
  "dependencies": {
    "@lol/lcu": "file:../../libs/lol-lcu",
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
