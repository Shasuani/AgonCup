# AgonCup — example environment file.
# Copy to .env and fill in secrets. `.env` is git-ignored; `.env.example` is NOT.
# Every variable referenced by infra/docker-compose.yml MUST be declared here.

# ---- Core runtime config (12-factor) ----
# Sensible non-secret dev defaults. Hostnames match docker-compose service names.
# DATABASE_URL = the migration/owner connection (superuser; bypasses RLS).
DATABASE_URL=postgresql+asyncpg://lol:lol@postgres:5432/lol
# APP_DATABASE_URL = the request-path connection as the non-BYPASSRLS app_rw role
# (created by migration 0002) so FORCE-RLS guild policies actually apply. If left
# empty the app falls back to DATABASE_URL and RLS is NOT enforced (PLAN.md §9).
APP_DATABASE_URL=postgresql+asyncpg://app_rw:app_rw@postgres:5432/lol
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---- Postgres container bootstrap ----
# Used by the official postgres image to initialize the dev database.
# Keep these in sync with the credentials embedded in DATABASE_URL above.
POSTGRES_USER=lol
POSTGRES_PASSWORD=lol
POSTGRES_DB=lol

# ---- Discord (OAuth + bot) ----
# Secrets: leave empty here, set real values in .env.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# OAuth2 redirect URI registered in the Discord developer portal. Must match the
# /auth/callback route exactly. Override per environment.
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# Public origin of the admin SPA. /auth/callback 303s the browser back to
# <FRONTEND_BASE_URL>/auth/callback with the token pair in the URL fragment.
# Set this to the real site in production (e.g. https://lol.gameras.gr).
FRONTEND_BASE_URL=http://localhost:5173
# Permission bitfield for the "Add bot to server" invite URL. 117761 =
# Create Invite + View Channels + Send Messages + Embed Links + Attach Files +
# Read History. (Create Invite: a player approved into a team from another
# server gets a DM with an invite to the team's server.)
DISCORD_BOT_PERMISSIONS=117761

# ---- Bot <-> backend service auth (PLAN.md §3.2) ----
# Shared secret the Discord bot presents to the backend's /integrations/discord
# bridge in the X-Service-Token header. The bot is the SOLE token holder; the
# backend trusts the Discord context it asserts (user/guild ids, is_admin) because
# only the bot can present this token. Leave empty here; set a strong random value
# in .env (the bridge fails closed with 503 until it is configured).
BOT_SERVICE_TOKEN=

# ---- Riot (Account-V1 personal key only; NO Tournament API) ----
RIOT_API_KEY=
# Default continental routing cluster for Account-V1: americas | asia | europe.
RIOT_REGION=americas

# ---- Auth ----
# Secret used to sign short-lived access JWTs. Generate a strong random value.
JWT_SECRET=
# Token lifetimes (seconds). Access ~15m, refresh ~30d. Defaults are sensible.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Leeway for re-presenting a just-rotated refresh token. Covers benign races (two
# tabs booting, a retried request) that would otherwise read as theft and revoke
# the session. Outside it, reuse still burns the token family. 0 = strict.
REFRESH_ROTATION_GRACE_SECONDS=15

# ---- PII-at-rest encryption (Fernet) ----
# Encrypts OAuth tokens + verification state at rest (PLAN.md §7). Read by
# app.security.crypto. Comma-separated for key rotation (first = primary).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in dev to use the insecure built-in dev fallback; REQUIRED in
# staging/production (the app fails to encrypt without it).
PII_ENCRYPTION_KEY=
