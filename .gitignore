# Electron / desktop build output
# dist-renderer/ is the Vite build of services/desktop/renderer (the React source,
# which IS tracked). Generated by `npm run build` — never commit it.
dist-renderer/
release/
app-dist/
*.dmg
*.app
*.exe
*.msi
*.AppImage
*.deb
*.snap

# Design-tool export scratch (leagueofleagues-ui). Its .tsx sources were already
# integrated into services/desktop/renderer/; the folder also carries its own
# node_modules/ + dist/. Kept locally, never committed.
export*/

